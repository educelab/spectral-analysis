Bootstrap: docker
From: ubuntu:22.04

%labels
  MAINTAINER Seth Parker <c.seth.parker@uky.edu>
  OS Ubuntu 22.04

%files
  /tmp/spectral-analysis /usr/local/educelab/spectral-analysis

%post -c /bin/bash
  # Exit on first error
  set -e

  # Basic installs
  apt update
  DEBIAN_FRONTEND=noninteractive apt install -y --no-install-recommends \
    curl \
    git \
    locales \
    make \
    nano \
    perl \
    python3 \
    python3-venv \
    tzdata \
    vim
  curl https://bootstrap.pypa.io/get-pip.py | python3

  # Fix locales
  locale-gen en_US en_US.UTF-8
  dpkg-reconfigure --frontend=noninteractive locales

  # Install exiftool
  echo "Installing ExifTool"
  mkdir -p /usr/local/educelab/exiftool/ && cd /usr/local/educelab/exiftool/
  EXIFTOOL_VER=$(curl --no-progress-meter https://exiftool.org/ver.txt)
  curl -O -L https://exiftool.org/Image-ExifTool-${EXIFTOOL_VER}.tar.gz
  tar -xzf Image-ExifTool-${EXIFTOOL_VER}.tar.gz
  cd Image-ExifTool-${EXIFTOOL_VER}/
  perl Makefile.PL
  make test
  make install
  echo "Exiftool ${EXIFTOOL_VER} installed"

  # Create a venv for this project
  python3 -m venv /usr/local/educelab/spectral-analysis/.venv/

  # Activate virtualenv
  source /usr/local/educelab/spectral-analysis/.venv/bin/activate
  # Update pip
  python3 -m pip install --upgrade pip wheel setuptools

  # Install code
  python3 -m pip install --editable /usr/local/educelab/spectral-analysis

  # Give read/write access to code (so it can later be edited using a persistent overlay)
  chmod --recursive a+rw /usr/local/educelab

  # Store git credentials for up to an hour (in overlay, not container) for convenience
  git config --global credential.helper cache
  git config --global credential.helper 'cache --timeout=3600'
  git config --global --add safe.directory /usr/local/educelab/spectral-analysis

%runscript
#!/bin/bash
  if [ $# -lt 1 ]; then
      echo "Usage: ./container <command>"
      exit 1
  fi

  source /usr/local/educelab/spectral-analysis/.venv/bin/activate
  exec "$@"

%help
  This container provides an environment for running the EduceLab spectral-analysis project.

  Available Commands
    - `spec-enhance` - Apply contrast enhancements to input image(s)
    - `spec-pca`     - Apply Principal Component Analysis (PCA) to input images

  Usage Tips:
    - Inside the container, the spectral-analysis source code can be found at:
      `/usr/local/educelab/spectral-analysis/`
    - The Python package is installed to the provided venv in editable mode:
      `/usr/local/educelab/spectral-analysis/.venv/`
    - The provided venv is automatically loaded by the runscript, but any shell usage should first activate it:
      `source /usr/local/educelab/spectral-analysis/.venv/bin/activate`
    - It is possible to use an overlay to check out another branch, pull recent changes, or make local edits to the
      code. To create and use a persistent overlay:
      `dd if=/dev/zero of=spectral-analysis.overlay bs=1M count=500 && mkfs.ext3 spectral-analysis.overlay`
      `singularity shell --overlay spectral-analysis.overlay spectral-analysis.sif`
    - When using an overlay and committing code changes, you should use `git config` inside of the source directory
      to set your name and email address for accurate commit authorship.
